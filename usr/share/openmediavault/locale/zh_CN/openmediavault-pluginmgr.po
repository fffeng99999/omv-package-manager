msgid "Package Manager"
msgstr "软件包管理器"

msgid "Package details"
msgstr "软件包详细信息"

msgid "Package"
msgstr "软件包"

msgid "Status"
msgstr "状态"

msgid "Installed version"
msgstr "已安装版本"

msgid "Repository version"
msgstr "仓库版本"

msgid "Candidate"
msgstr "候选版本"

msgid "Architecture"
msgstr "架构"

msgid "Origin"
msgstr "来源"

msgid "Section"
msgstr "组件"

msgid "Priority"
msgstr "优先级"

msgid "Hold"
msgstr "保留"

msgid "Installed size"
msgstr "安装大小"

msgid "Download size"
msgstr "下载大小"

msgid "Maintainer"
msgstr "维护者"

msgid "Homepage"
msgstr "主页"

msgid "Dependencies"
msgstr "依赖"

msgid "Pre-depends"
msgstr "前置依赖"

msgid "Recommends"
msgstr "推荐"

msgid "Suggests"
msgstr "建议"

msgid "Description"
msgstr "描述"

msgid "Installed"
msgstr "已安装"

msgid "Not installed"
msgstr "未安装"

msgid "Upgradable"
msgstr "可升级"

msgid "Package operations may break your OpenMediaVault system. Make sure you have a current backup of your configuration before continuing. Packages starting with 'openmediavault' are protected against removal."
msgstr "软件包操作可能会破坏您的 OpenMediaVault 系统。请确保在继续之前已备份当前配置。以 'openmediavault' 开头的软件包受保护，不会被移除。"

msgid "Version"
msgstr "版本"

msgid "Size"
msgstr "大小"

msgid "Details"
msgstr "详细信息"

msgid "Actions"
msgstr "操作"

msgid "Preview"
msgstr "预览"

msgid "Show what would happen before removing this package"
msgstr "在移除此软件包之前显示将会发生什么"

msgid "Preview of the operation"
msgstr "操作预览"

msgid "Prevent the package from being upgraded"
msgstr "阻止该软件包被升级"

msgid "The package is now held. It will not be upgraded automatically."
msgstr "该软件包已被保留，将不会被自动升级。"

msgid "Unhold"
msgstr "取消保留"

msgid "Allow the package to be upgraded again"
msgstr "允许该软件包再次升级"

msgid "The package is no longer held and will be upgraded again."
msgstr "该软件包已取消保留，将再次被升级。"

msgid "Remove"
msgstr "移除"

msgid "Do you really want to remove the selected package? Removing packages may break your system. Packages starting with 'openmediavault' will be refused."
msgstr "您确定要移除所选软件包吗？移除软件包可能会破坏您的系统。以 'openmediavault' 开头的软件包将被拒绝移除。"

msgid "Removing package"
msgstr "正在移除软件包"

msgid "Purge"
msgstr "清除"

msgid "Do you really want to purge the selected package? Purging also removes its configuration files."
msgstr "您确定要清除所选软件包吗？清除操作还会删除其配置文件。"

msgid "Purging package"
msgstr "正在清除软件包"

msgid "Available"
msgstr "可用"

msgid "Installing packages may break your OpenMediaVault system. Make sure you have a current backup of your configuration before continuing."
msgstr "安装软件包可能会破坏您的 OpenMediaVault 系统。请确保在继续之前已备份当前配置。"

msgid "Install"
msgstr "安装"

msgid "Do you really want to install the selected package?"
msgstr "您确定要安装所选软件包吗？"

msgid "Installing package"
msgstr "正在安装软件包"

msgid "Updates"
msgstr "更新"

msgid "Upgrading packages may break your OpenMediaVault system. Make sure you have a current backup of your configuration before continuing."
msgstr "升级软件包可能会破坏您的 OpenMediaVault 系统。请确保在继续之前已备份当前配置。"

msgid "Current"
msgstr "当前"

msgid "New"
msgstr "新版"

msgid "Update lists"
msgstr "更新列表"

msgid "Updating the package index files"
msgstr "正在更新软件包索引文件"

msgid "Upgrade all"
msgstr "全部升级"

msgid "Do you really want to upgrade all available packages? This operation may take a long time and may break your OpenMediaVault system."
msgstr "您确定要升级所有可用软件包吗？此操作可能耗时较长，并可能破坏您的 OpenMediaVault 系统。"

msgid "Upgrading all packages"
msgstr "正在升级所有软件包"

msgid "Autoremove"
msgstr "自动移除"

msgid "Do you really want to remove all packages that were automatically installed and are no longer required?"
msgstr "您确定要移除所有自动安装且不再需要的软件包吗？"

msgid "Removing unneeded packages"
msgstr "正在移除不再需要的软件包"

msgid "Upgrade"
msgstr "升级"

msgid "Do you really want to upgrade the selected package?"
msgstr "您确定要升级所选软件包吗？"

msgid "Upgrading package"
msgstr "正在升级软件包"

msgid "Local deb"
msgstr "本地 deb"

msgid "Select the shared folder and the .deb file to install. Upload the .deb file to a shared folder first (e.g. via File Browser or SMB)."
msgstr "选择要安装的共享文件夹和 .deb 文件。请先将 .deb 文件上传到共享文件夹（例如通过 File Browser 或 SMB）。"

msgid "Shared folder"
msgstr "共享文件夹"

msgid "The shared folder that contains the .deb file."
msgstr "包含该 .deb 文件的共享文件夹。"

msgid "Folder"
msgstr "文件夹"

msgid "The directory below the shared folder root that contains the .deb file."
msgstr "共享文件夹根目录下包含该 .deb 文件的目录。"

msgid "Filename"
msgstr "文件名"

msgid "The name of the .deb file, e.g. 'openmediavault-example_1.0_all.deb'."
msgstr ".deb 文件的名称，例如 'openmediavault-example_1.0_all.deb'。"

msgid "Show package info"
msgstr "显示软件包信息"

msgid "Package {{ _response['package'] }} version {{ _response['version'] }} architecture {{ _response['architecture'] }}"
msgstr "软件包 {{ _response['package'] }}，版本 {{ _response['version'] }}，架构 {{ _response['architecture'] }}"

msgid "Do you really want to install this local .deb package? Installing packages may break your system."
msgstr "您确定要安装此本地 .deb 软件包吗？安装软件包可能会破坏您的系统。"

msgid "Upload .deb file from your computer"
msgstr "从电脑上传 .deb 安装包"

msgid "Modified"
msgstr "修改时间"

msgid "Do you really want to install the selected .deb package? Installing packages may break your system."
msgstr "您确定要安装所选的 .deb 软件包吗？安装软件包可能会破坏您的系统。"

msgid "Upload .deb files from your computer via the upload button (opens a new browser tab), or select an existing .deb file in the /tmp directory of this system. Uploaded files are stored in /tmp and are cleaned up automatically by the system. Installing packages may break your OpenMediaVault system. Make sure you have a current backup of your configuration before continuing."
msgstr "点击上传按钮从电脑上传 .deb 安装包（会在新浏览器标签页打开），或选择本机 /tmp 目录中已有的 .deb 文件。上传的文件保存在 /tmp，由系统自动清理。安装软件包可能会破坏您的 OpenMediaVault 系统。请确保在继续之前已备份当前配置。"
